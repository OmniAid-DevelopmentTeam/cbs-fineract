<!--
    OmniAid (OMSD-2152): units of measure as currencies, for aid programmes whose limit is in units. A programme that
    gives out 20 kg of rice a month is a savings product in KGM: the beneficiary's balance is kept in grams, as a money
    programme's is in cents.
    Codes are UN/CEFACT (Rec. 20): no longer than m_currency.code's three characters and not ISO 4217 codes.

      LTR  litre      3 decimals (millilitres)
      KGM  kilogram   3 decimals (grams)
      H87  piece      0 decimals

    Fineract has no API that creates a currency (PUT /currencies only enables codes m_currency already has), and a
    product or account in a code missing from m_currency silently drops out of every listing: the reads inner-join
    m_currency. The codes are also enabled for the organisation here, so products can be made in them right after the
    deploy, without a manual PUT /currencies on every tenant. A later PUT /currencies must keep them in its list.

    Explicit ids past the 164 currencies of 0002_initial_data: on PostgreSQL an explicit id does not move the sequence,
    and an insert by the sequence would collide with the seeded rows. The organisation's rows take MAX(id) + 1 for the
    same reason. Every changeSet is guarded by the code, so a tenant that already has it marks it ran.
-->
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">
    <changeSet author="omniaid" id="units-currency-LTR">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM m_currency WHERE code = 'LTR'</sqlCheck>
        </preConditions>
        <insert tableName="m_currency">
            <column name="id" valueNumeric="1001"/>
            <column name="code" value="LTR"/>
            <column name="decimal_places" valueNumeric="3"/>
            <column name="currency_multiplesof"/>
            <column name="display_symbol" value="L"/>
            <column name="name" value="Litre"/>
            <column name="internationalized_name_code" value="currency.LTR"/>
        </insert>
    </changeSet>
    <changeSet author="omniaid" id="units-currency-KGM">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM m_currency WHERE code = 'KGM'</sqlCheck>
        </preConditions>
        <insert tableName="m_currency">
            <column name="id" valueNumeric="1002"/>
            <column name="code" value="KGM"/>
            <column name="decimal_places" valueNumeric="3"/>
            <column name="currency_multiplesof"/>
            <column name="display_symbol" value="kg"/>
            <column name="name" value="Kilogram"/>
            <column name="internationalized_name_code" value="currency.KGM"/>
        </insert>
    </changeSet>
    <changeSet author="omniaid" id="units-currency-H87">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM m_currency WHERE code = 'H87'</sqlCheck>
        </preConditions>
        <insert tableName="m_currency">
            <column name="id" valueNumeric="1003"/>
            <column name="code" value="H87"/>
            <column name="decimal_places" valueNumeric="0"/>
            <column name="currency_multiplesof"/>
            <column name="display_symbol" value="pcs"/>
            <column name="name" value="Piece"/>
            <column name="internationalized_name_code" value="currency.H87"/>
        </insert>
    </changeSet>
    <changeSet author="omniaid" id="units-organisation-LTR">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM m_organisation_currency WHERE code = 'LTR'</sqlCheck>
        </preConditions>
        <sql>
            INSERT INTO m_organisation_currency (id, code, decimal_places, currency_multiplesof, name, display_symbol,
                                                 internationalized_name_code)
            SELECT COALESCE(MAX(id), 0) + 1, 'LTR', 3, NULL, 'Litre', 'L', 'currency.LTR' FROM m_organisation_currency
        </sql>
    </changeSet>
    <changeSet author="omniaid" id="units-organisation-KGM">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM m_organisation_currency WHERE code = 'KGM'</sqlCheck>
        </preConditions>
        <sql>
            INSERT INTO m_organisation_currency (id, code, decimal_places, currency_multiplesof, name, display_symbol,
                                                 internationalized_name_code)
            SELECT COALESCE(MAX(id), 0) + 1, 'KGM', 3, NULL, 'Kilogram', 'kg', 'currency.KGM' FROM m_organisation_currency
        </sql>
    </changeSet>
    <changeSet author="omniaid" id="units-organisation-H87">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM m_organisation_currency WHERE code = 'H87'</sqlCheck>
        </preConditions>
        <sql>
            INSERT INTO m_organisation_currency (id, code, decimal_places, currency_multiplesof, name, display_symbol,
                                                 internationalized_name_code)
            SELECT COALESCE(MAX(id), 0) + 1, 'H87', 0, NULL, 'Piece', 'pcs', 'currency.H87' FROM m_organisation_currency
        </sql>
    </changeSet>
</databaseChangeLog>
